 	shared_ptr<iostream> errorLog;
 
+#ifdef __3DS__
+	// The SD card reports some errors (e.g. for missing files) with codes
+	// that std::filesystem does not expect, which makes the throwing versions
+	// of these functions fail, and stat() is not reliable for directories on
+	// every system (or emulator). Directories are recognized by opening them.
+	bool IsDirectory(const filesystem::path &path)
+	{
+		DIR *dir = opendir(path.string().c_str());
+		if(!dir)
+			return false;
+		closedir(dir);
+		return true;
+	}
+
+	bool PathExists(const filesystem::path &path)
+	{
+		error_code error;
+		return filesystem::exists(path, error) || IsDirectory(path);
+	}
+
+	bool IsRegularFile(const filesystem::path &path)
+	{
+		error_code error;
+		return filesystem::is_regular_file(path, error) && !IsDirectory(path);
+	}
+
+	// List the files (or the directories) in a directory, with readdir().
+	void ListDirectory(const filesystem::path &directory, bool directories, bool recursive,
+		vector<filesystem::path> &list)
+	{
+		DIR *dir = opendir(directory.string().c_str());
+		if(!dir)
+			return;
+		vector<filesystem::path> subdirectories;
+		while(dirent *entry = readdir(dir))
+		{
+			string name = entry->d_name;
+			if(name == "." || name == "..")
+				continue;
+			filesystem::path path = directory / name;
+			bool isDirectory = (entry->d_type == DT_DIR)
+				|| (entry->d_type == DT_UNKNOWN && IsDirectory(path));
+			if(isDirectory)
+				subdirectories.push_back(path);
+			if(isDirectory == directories)
+				list.push_back(path);
+		}
+		closedir(dir);
+		if(recursive)
+			for(const filesystem::path &path : subdirectories)
+				ListDirectory(path, directories, true, list);
+	}
+#else
+	bool PathExists(const filesystem::path &path)
+	{
+		return exists(path);
+	}
+
+	bool IsDirectory(const filesystem::path &path)
+	{
+		return is_directory(path);
+	}
+
+	bool IsRegularFile(const filesystem::path &path)
+	{
+		return is_regular_file(path);
+	}
+#endif
+
