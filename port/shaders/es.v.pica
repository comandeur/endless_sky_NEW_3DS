;
; The single vertex shader used by the 3DS renderer. All of the geometry that the
; desktop game computes in GLSL is computed on the CPU instead (see ctr/Gfx.cpp),
; so this shader only has to project 2D points and forward the texture
; coordinates and the vertex color. The fragment stage is configured with the
; PICA200 texture combiners.

; Uniforms
.fvec projection[4]

; Constants
.constf consts(0.0, 1.0, 0.00392156862745098, 0.0)
.alias zero consts.xxxx
.alias one consts.yyyy
.alias inv255 consts.zzzz

; Outputs
.out outpos position
.out outtc0 texcoord0
.out outtc1 texcoord1
.out outtc2 texcoord2
.out outclr color

; Inputs
.alias inpos v0 ; x, y in canvas coordinates
.alias intc  v1 ; u, v
.alias inclr v2 ; r, g, b, a as unsigned bytes (0 - 255)

.proc main
	; r0 = (x, y, 0, 1)
	mov r0.xy, inpos.xy
	mov r0.z, zero
	mov r0.w, one

	dp4 outpos.x, projection[0], r0
	dp4 outpos.y, projection[1], r0
	dp4 outpos.z, projection[2], r0
	dp4 outpos.w, projection[3], r0

	; Every texture unit uses the same coordinates.
	mov outtc0, intc
	mov outtc1, intc
	mov outtc2, intc

	; Normalize the color.
	mul outclr, inv255, inclr

	end
.end
